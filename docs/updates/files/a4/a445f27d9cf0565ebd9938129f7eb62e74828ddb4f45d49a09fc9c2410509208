/* ═══════════════════════════════════════════════════════════════
   Seva Sagar — design system
   adaptive: light / dark / amoled  ·  accents: green saffron sky rose gold
   no external fonts, no network assets — everything renders offline
   ═══════════════════════════════════════════════════════════════ */

*,*::before,*::after{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;padding:0;height:100%;overflow:hidden;overscroll-behavior:none}
body{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans","Noto Sans Devanagari","Nirmala UI",sans-serif;
  font-size:15px;line-height:1.45;color:var(--text);background:var(--bg);
  -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;
  user-select:none;-webkit-user-select:none;
}
img,svg{display:block;max-width:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{background:none;border:0;cursor:pointer;padding:0}
input,textarea,select{user-select:text;-webkit-user-select:text}

/* ── tokens ─────────────────────────────────────────────── */
:root{
  --sat:env(safe-area-inset-top,24px);
  --sab:env(safe-area-inset-bottom,0px);
  --r-lg:22px; --r-md:16px; --r-sm:12px; --r-pill:999px;
  --sp:16px;
  --ease:cubic-bezier(.2,.8,.2,1);
  --fast:160ms; --med:260ms; --slow:420ms;
  --maxw:520px;
  --tab-h:64px;
}
html[data-accent="green"] {--ac:#22C55E;--ac-2:#16A34A;--ac-soft:rgba(34,197,94,.14);--ac-ink:#04140A;--ac-glow:rgba(34,197,94,.35)}
html[data-accent="saffron"]{--ac:#FF9A2E;--ac-2:#F97316;--ac-soft:rgba(255,154,46,.15);--ac-ink:#1A0C00;--ac-glow:rgba(255,154,46,.35)}
html[data-accent="sky"]   {--ac:#38BDF8;--ac-2:#0EA5E9;--ac-soft:rgba(56,189,248,.15);--ac-ink:#03121C;--ac-glow:rgba(56,189,248,.35)}
html[data-accent="rose"]  {--ac:#FB7185;--ac-2:#F43F5E;--ac-soft:rgba(251,113,133,.15);--ac-ink:#1C0509;--ac-glow:rgba(251,113,133,.35)}
html[data-accent="gold"]  {--ac:#EAB308;--ac-2:#CA8A04;--ac-soft:rgba(234,179,8,.15);--ac-ink:#171200;--ac-glow:rgba(234,179,8,.35)}

html[data-theme="dark"]{
  --bg:#0B0E13; --bg-2:#0F131A;
  --surface:#151A22; --surface-2:#1C222C; --surface-3:#232A36;
  --line:rgba(255,255,255,.075); --line-2:rgba(255,255,255,.13);
  --text:#EDF2F7; --text-2:#C3CDD9; --muted:#8C9AAC;
  --shadow:0 1px 0 rgba(255,255,255,.03) inset, 0 8px 24px rgba(0,0,0,.35);
  --overlay:rgba(4,7,11,.72);
  --warn:#FBBF24; --danger:#F87171; --info:#60A5FA;
}
html[data-theme="amoled"]{
  --bg:#000000; --bg-2:#05070A;
  --surface:#0A0D12; --surface-2:#12161D; --surface-3:#1A1F28;
  --line:rgba(255,255,255,.09); --line-2:rgba(255,255,255,.16);
  --text:#F2F6FA; --text-2:#C7D1DC; --muted:#8593A5;
  --shadow:0 0 0 1px rgba(255,255,255,.04);
  --overlay:rgba(0,0,0,.82);
  --warn:#FBBF24; --danger:#F87171; --info:#60A5FA;
}
html[data-theme="light"]{
  --bg:#F4F6FA; --bg-2:#EEF1F6;
  --surface:#FFFFFF; --surface-2:#F5F7FB; --surface-3:#EBEFF5;
  --line:rgba(15,23,42,.08); --line-2:rgba(15,23,42,.14);
  --text:#0D1520; --text-2:#334155; --muted:#64748B;
  --shadow:0 1px 2px rgba(16,24,40,.05), 0 8px 24px rgba(16,24,40,.07);
  --overlay:rgba(15,23,42,.42);
  --warn:#B45309; --danger:#DC2626; --info:#2563EB;
}

/* ── splash ─────────────────────────────────────────────── */
.splash{position:fixed;inset:0;z-index:200;display:flex;flex-direction:column;
  align-items:center;justify-content:center;gap:6px;background:#070C16;
  transition:opacity var(--slow) var(--ease),visibility var(--slow)}
.splash.is-out{opacity:0;visibility:hidden;pointer-events:none}
.splash-glow{position:absolute;width:78vmin;height:78vmin;border-radius:50%;
  background:radial-gradient(circle,rgba(34,197,94,.20),transparent 62%);
  filter:blur(14px);animation:pulse 2.6s var(--ease) infinite}
.splash-mark{width:132px;height:132px;position:relative;animation:markIn 900ms var(--ease) both}
.mark-svg{width:100%;height:100%;overflow:visible}
.mark-ring{stroke-dasharray:252;stroke-dashoffset:252;animation:draw 1.1s var(--ease) .15s forwards}
.mark-lotus{transform-origin:54px 66px;animation:bloom 780ms var(--ease) .25s both}
.mark-flame{transform-origin:54px 44px;animation:flicker 2.4s ease-in-out 1s infinite,fadeUp 600ms var(--ease) .5s both}
.mark-wave{stroke-dasharray:120;stroke-dashoffset:120;animation:draw 900ms var(--ease) .65s forwards}
.splash-name{margin-top:18px;font-size:27px;font-weight:800;letter-spacing:.4px;color:#F3F7FA;
  animation:fadeUp 620ms var(--ease) .55s both}
.splash-sub{font-size:12.5px;color:#8FA3B8;letter-spacing:.2px;animation:fadeUp 620ms var(--ease) .7s both}
.splash-bar{margin-top:26px;width:132px;height:3px;border-radius:9px;background:rgba(255,255,255,.09);overflow:hidden}
.splash-bar i{display:block;height:100%;width:40%;border-radius:9px;
  background:linear-gradient(90deg,var(--ac,#22C55E),#FFD166);animation:load 1.25s var(--ease) infinite}
@keyframes draw{to{stroke-dashoffset:0}}
@keyframes bloom{from{opacity:0;transform:scale(.55) translateY(8px)}to{opacity:1;transform:none}}
@keyframes markIn{from{opacity:0;transform:scale(.86)}to{opacity:1;transform:none}}
@keyframes fadeUp{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
@keyframes flicker{0%,100%{transform:scale(1) rotate(0)}35%{transform:scale(1.07,1.12) rotate(-1.5deg)}70%{transform:scale(.97,.95) rotate(1.5deg)}}
@keyframes pulse{0%,100%{opacity:.55;transform:scale(1)}50%{opacity:.95;transform:scale(1.06)}}
@keyframes load{0%{transform:translateX(-105%)}100%{transform:translateX(255%)}}

/* ── app frame ──────────────────────────────────────────── */
.app{position:fixed;inset:0;display:flex;flex-direction:column;background:var(--bg);
  transition:background var(--med) var(--ease)}
.topbar{flex:0 0 auto;padding:calc(var(--sat) + 10px) var(--sp) 10px;
  background:linear-gradient(180deg,var(--bg) 62%,transparent);position:relative;z-index:20}
.topbar-in{max-width:var(--maxw);margin:0 auto;display:flex;align-items:center;gap:12px}
.hi{flex:1;min-width:0}
.hi-1{font-size:18px;font-weight:750;letter-spacing:.1px;display:flex;align-items:center;gap:6px}
.hi-2{font-size:12.5px;color:var(--muted);margin-top:1px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.icon-btn{width:40px;height:40px;border-radius:14px;display:grid;place-items:center;
  background:var(--surface);border:1px solid var(--line);color:var(--text-2);position:relative;
  transition:transform var(--fast) var(--ease),background var(--fast)}
.icon-btn:active{transform:scale(.92)}
.icon-btn .dot{position:absolute;top:7px;right:8px;width:8px;height:8px;border-radius:50%;
  background:var(--ac);box-shadow:0 0 0 2px var(--surface)}
.avatar{width:40px;height:40px;border-radius:14px;display:grid;place-items:center;font-weight:800;
  font-size:15px;color:var(--ac-ink);background:linear-gradient(140deg,var(--ac),var(--ac-2));
  box-shadow:0 4px 14px var(--ac-glow)}

.pages{flex:1;position:relative;overflow:hidden}
.page{position:absolute;inset:0;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;
  padding:4px var(--sp) calc(var(--tab-h) + var(--sab) + 30px);
  opacity:0;visibility:hidden;transform:translateY(8px);
  transition:opacity var(--med) var(--ease),transform var(--med) var(--ease),visibility var(--med);
  scrollbar-width:none}
.page::-webkit-scrollbar{display:none}
.page.is-active{opacity:1;visibility:visible;transform:none}
.wrap{max-width:var(--maxw);margin:0 auto}

/* ── tabbar + fab ───────────────────────────────────────── */
.tabbar{position:absolute;left:0;right:0;bottom:0;z-index:30;height:calc(var(--tab-h) + var(--sab));
  padding-bottom:var(--sab);display:flex;align-items:center;justify-content:space-around;
  background:color-mix(in srgb,var(--surface) 88%,transparent);
  border-top:1px solid var(--line);backdrop-filter:blur(18px) saturate(1.4);
  -webkit-backdrop-filter:blur(18px) saturate(1.4)}
.tab{flex:1;height:var(--tab-h);display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:3px;color:var(--muted);transition:color var(--fast) var(--ease);position:relative}
.tab .tab-ico{transition:transform var(--med) var(--ease)}
.tab.is-active{color:var(--ac)}
.tab.is-active .tab-ico{transform:translateY(-2px) scale(1.06)}
.tab.is-active::before{content:"";position:absolute;top:0;width:26px;height:3px;border-radius:0 0 4px 4px;
  background:var(--ac);box-shadow:0 0 12px var(--ac-glow)}
.tab-lbl{font-size:10.5px;font-weight:650;letter-spacing:.2px}
.tab-gap{flex:0 0 62px}
.fab{position:absolute;left:50%;transform:translateX(-50%);bottom:calc(var(--sab) + 22px);
  width:56px;height:56px;border-radius:20px;display:grid;place-items:center;color:var(--ac-ink);
  background:linear-gradient(140deg,var(--ac),var(--ac-2));
  box-shadow:0 10px 26px var(--ac-glow),0 2px 6px rgba(0,0,0,.25);
  transition:transform var(--med) var(--ease),box-shadow var(--med)}
.fab:active{transform:translateX(-50%) scale(.9)}
.fab.is-open{transform:translateX(-50%) rotate(135deg)}

/* ── cards ──────────────────────────────────────────────── */
.card{background:var(--surface);border:1px solid var(--line);border-radius:var(--r-lg);
  padding:16px;box-shadow:var(--shadow);margin-bottom:14px;position:relative;overflow:hidden}
.card.tight{padding:13px}
.card-h{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px}
.card-t{font-size:14.5px;font-weight:730;letter-spacing:.1px}
.card-s{font-size:11.5px;color:var(--muted);margin-top:2px}
.link{font-size:12.5px;font-weight:650;color:var(--ac);display:flex;align-items:center;gap:3px}
.sec-t{font-size:12px;font-weight:750;letter-spacing:.7px;text-transform:uppercase;color:var(--muted);
  margin:20px 2px 10px;display:flex;align-items:center;justify-content:space-between}

/* hero */
.hero{background:
   radial-gradient(120% 100% at 100% 0%,var(--ac-soft),transparent 58%),
   var(--surface);
  border:1px solid var(--line);border-radius:26px;padding:18px;margin-bottom:14px;
  box-shadow:var(--shadow);position:relative;overflow:hidden}
.hero::after{content:"";position:absolute;right:-46px;top:-46px;width:150px;height:150px;border-radius:50%;
  background:radial-gradient(circle,var(--ac-glow),transparent 68%);opacity:.5;pointer-events:none}
.hero-row{display:flex;align-items:center;gap:16px}
.ring{position:relative;flex:0 0 auto;width:92px;height:92px}
.ring svg{transform:rotate(-90deg)}
.ring circle{fill:none;stroke-linecap:round}
.ring .bg{stroke:var(--surface-3)}
.ring .fg{stroke:url(#ringGrad);transition:stroke-dashoffset 900ms var(--ease)}
.ring-c{position:absolute;inset:0;display:grid;place-items:center;text-align:center}
.ring-n{font-size:23px;font-weight:800;line-height:1}
.ring-l{font-size:10px;color:var(--muted);margin-top:2px;letter-spacing:.3px}
.hero-info{flex:1;min-width:0}
.hero-t{font-size:16.5px;font-weight:760}
.hero-d{font-size:12.5px;color:var(--muted);margin-top:3px}
.pill{display:inline-flex;align-items:center;gap:5px;padding:5px 10px;border-radius:var(--r-pill);
  font-size:11.5px;font-weight:680;background:var(--surface-2);border:1px solid var(--line);color:var(--text-2)}
.pill.ac{background:var(--ac-soft);border-color:transparent;color:var(--ac)}
.pill.warn{background:color-mix(in srgb,var(--warn) 16%,transparent);color:var(--warn);border-color:transparent}
.hero-actions{display:flex;gap:9px;margin-top:14px}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;height:44px;padding:0 18px;
  border-radius:14px;font-size:14px;font-weight:700;letter-spacing:.1px;
  background:var(--surface-2);color:var(--text);border:1px solid var(--line);
  transition:transform var(--fast) var(--ease),filter var(--fast),background var(--fast)}
.btn:active{transform:scale(.965)}
.btn.primary{background:linear-gradient(140deg,var(--ac),var(--ac-2));color:var(--ac-ink);border-color:transparent;
  box-shadow:0 6px 18px var(--ac-glow)}
.btn.ghost{background:transparent}
.btn.block{width:100%}
.btn.sm{height:36px;padding:0 13px;font-size:12.5px;border-radius:11px}
.btn.danger{color:var(--danger);border-color:color-mix(in srgb,var(--danger) 30%,transparent);
  background:color-mix(in srgb,var(--danger) 10%,transparent)}
.btn[disabled]{opacity:.5;pointer-events:none}
.btn-row{display:flex;gap:9px}
.btn-row>*{flex:1}

/* quick actions */
.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:9px}
.qa{background:var(--surface-2);border:1px solid var(--line);border-radius:18px;padding:12px 6px 10px;
  display:flex;flex-direction:column;align-items:center;gap:7px;
  transition:transform var(--fast) var(--ease),background var(--fast)}
.qa:active{transform:scale(.94)}
.qa-i{width:38px;height:38px;border-radius:13px;display:grid;place-items:center;
  background:var(--ac-soft);color:var(--ac)}
.qa-l{font-size:10.5px;font-weight:680;color:var(--text-2);text-align:center;line-height:1.25}

/* lists */
.list{display:flex;flex-direction:column;gap:9px}
.row{display:flex;align-items:center;gap:12px;padding:12px;border-radius:var(--r-md);
  background:var(--surface-2);border:1px solid var(--line);
  transition:transform var(--fast) var(--ease),background var(--fast)}
.row:active{transform:scale(.985)}
.row-i{flex:0 0 auto;width:40px;height:40px;border-radius:13px;display:grid;place-items:center;
  background:var(--ac-soft);color:var(--ac)}
.row-b{flex:1;min-width:0}
.row-t{font-size:14px;font-weight:670;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row-s{font-size:11.5px;color:var(--muted);margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row-e{text-align:right;flex:0 0 auto}
.row-n{font-size:15px;font-weight:780;color:var(--ac)}
.row-u{font-size:10px;color:var(--muted)}
.chev{color:var(--muted);opacity:.65}

.empty{text-align:center;padding:30px 16px;color:var(--muted)}
.empty-i{width:58px;height:58px;margin:0 auto 12px;border-radius:20px;display:grid;place-items:center;
  background:var(--surface-2);color:var(--ac);opacity:.9}
.empty-t{font-size:14px;font-weight:680;color:var(--text-2)}
.empty-s{font-size:12px;margin-top:5px;line-height:1.5}

/* chips */
.chips{display:flex;gap:8px;overflow-x:auto;padding:2px 0 4px;scrollbar-width:none;margin:0 calc(var(--sp)*-1);
  padding-left:var(--sp);padding-right:var(--sp)}
.chips::-webkit-scrollbar{display:none}
.chip{flex:0 0 auto;padding:8px 14px;border-radius:var(--r-pill);font-size:12.5px;font-weight:650;
  background:var(--surface);border:1px solid var(--line);color:var(--text-2);white-space:nowrap;
  transition:all var(--fast) var(--ease)}
.chip.is-on{background:var(--ac);border-color:transparent;color:var(--ac-ink);box-shadow:0 4px 14px var(--ac-glow)}
.chip:active{transform:scale(.95)}

/* week strip */
.week{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}
.wd{text-align:center;padding:8px 2px;border-radius:13px;background:var(--surface-2);border:1px solid var(--line)}
.wd.today{border-color:var(--ac);background:var(--ac-soft)}
.wd-l{font-size:9.5px;color:var(--muted);font-weight:650}
.wd-n{font-size:12.5px;font-weight:720;margin-top:3px}
.wd-d{width:6px;height:6px;border-radius:50%;margin:5px auto 0;background:var(--surface-3)}
.wd.done .wd-d{background:var(--ac);box-shadow:0 0 8px var(--ac-glow)}

/* stats */
.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.stat{background:var(--surface-2);border:1px solid var(--line);border-radius:var(--r-md);padding:13px}
.stat-n{font-size:21px;font-weight:800;letter-spacing:-.3px}
.stat-l{font-size:11px;color:var(--muted);margin-top:2px}
.stat.ac .stat-n{color:var(--ac)}

/* heatmap */
.heat{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.heat-d{aspect-ratio:1;border-radius:8px;background:var(--surface-2);display:grid;place-items:center;
  font-size:10px;color:var(--muted);border:1px solid transparent;transition:transform var(--fast)}
.heat-d.l1{background:color-mix(in srgb,var(--ac) 22%,var(--surface-2));color:var(--text-2)}
.heat-d.l2{background:color-mix(in srgb,var(--ac) 45%,var(--surface-2));color:var(--ac-ink)}
.heat-d.l3{background:color-mix(in srgb,var(--ac) 72%,var(--surface-2));color:var(--ac-ink)}
.heat-d.l4{background:var(--ac);color:var(--ac-ink);font-weight:700}
.heat-d.today{border-color:var(--text-2)}
.heat-d.pad{background:transparent}
.heat-d:active{transform:scale(.88)}
.heat-h{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:5px}
.heat-h span{text-align:center;font-size:9.5px;color:var(--muted);font-weight:650}

/* bars chart */
.bars{display:flex;align-items:flex-end;gap:6px;height:96px;padding-top:8px}
.bar{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:5px;height:100%}
.bar i{width:100%;border-radius:7px 7px 4px 4px;background:linear-gradient(180deg,var(--ac),var(--ac-2));
  min-height:3px;transition:height 700ms var(--ease);opacity:.92}
.bar span{font-size:9.5px;color:var(--muted)}

/* forms */
.field{margin-bottom:13px}
.label{display:block;font-size:11.5px;font-weight:680;color:var(--muted);margin-bottom:6px;letter-spacing:.2px}
.input,.textarea,.select{width:100%;background:var(--surface-2);border:1px solid var(--line);
  border-radius:13px;padding:12px 13px;font-size:14.5px;color:var(--text);outline:none;
  transition:border-color var(--fast),background var(--fast)}
.input:focus,.textarea:focus,.select:focus{border-color:var(--ac);background:var(--surface)}
.textarea{min-height:78px;resize:none;line-height:1.5}
.select{appearance:none;background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);
  background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%;background-size:5px 5px,5px 5px;background-repeat:no-repeat;padding-right:34px}
.stepper{display:flex;align-items:center;gap:10px}
.stepper .input{text-align:center;font-size:19px;font-weight:750}
.step-b{width:46px;height:46px;flex:0 0 auto;border-radius:14px;background:var(--surface-2);
  border:1px solid var(--line);display:grid;place-items:center;color:var(--ac);font-size:20px;font-weight:700}
.step-b:active{transform:scale(.92)}
.seg{display:flex;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:4px;gap:4px}
.seg button{flex:1;height:36px;border-radius:11px;font-size:12.5px;font-weight:680;color:var(--muted);
  transition:all var(--fast) var(--ease)}
.seg button.is-on{background:var(--surface);color:var(--text);box-shadow:var(--shadow)}
html[data-theme="light"] .seg button.is-on{background:var(--ac);color:var(--ac-ink)}
.switch{width:46px;height:27px;border-radius:99px;background:var(--surface-3);position:relative;flex:0 0 auto;
  transition:background var(--med) var(--ease);border:1px solid var(--line)}
.switch i{position:absolute;top:2px;left:2px;width:21px;height:21px;border-radius:50%;background:var(--muted);
  transition:transform var(--med) var(--ease),background var(--med)}
.switch.is-on{background:var(--ac);border-color:transparent}
.switch.is-on i{transform:translateX(19px);background:#fff}
.swatches{display:flex;gap:10px}
.sw{width:34px;height:34px;border-radius:12px;border:2px solid transparent;position:relative;transition:transform var(--fast)}
.sw.is-on{border-color:var(--text);transform:scale(1.06)}
.sw:active{transform:scale(.92)}

/* settings rows */
.set{display:flex;align-items:center;gap:12px;padding:13px 14px;background:var(--surface);
  border:1px solid var(--line);border-bottom:0;transition:background var(--fast)}
.set:first-child{border-radius:var(--r-md) var(--r-md) 0 0}
.set:last-child{border-bottom:1px solid var(--line);border-radius:0 0 var(--r-md) var(--r-md)}
.set:only-child{border-radius:var(--r-md);border-bottom:1px solid var(--line)}
.set:active{background:var(--surface-2)}
.set-i{width:34px;height:34px;border-radius:11px;display:grid;place-items:center;flex:0 0 auto;
  background:var(--ac-soft);color:var(--ac)}
.set-b{flex:1;min-width:0}
.set-t{font-size:13.5px;font-weight:640}
.set-s{font-size:11px;color:var(--muted);margin-top:1px}
.set-group{margin-bottom:14px}

/* sheet */
.sheet-back{position:fixed;inset:0;z-index:100;background:var(--overlay);opacity:0;
  transition:opacity var(--med) var(--ease);backdrop-filter:blur(3px);-webkit-backdrop-filter:blur(3px)}
.sheet-back.is-in{opacity:1}
.sheet{position:fixed;left:0;right:0;bottom:0;z-index:101;background:var(--surface);
  border-radius:26px 26px 0 0;border:1px solid var(--line);border-bottom:0;
  padding:8px var(--sp) calc(var(--sab) + 18px);max-height:92vh;overflow-y:auto;
  transform:translateY(102%);transition:transform var(--med) var(--ease);
  box-shadow:0 -12px 40px rgba(0,0,0,.35);scrollbar-width:none}
.sheet::-webkit-scrollbar{display:none}
.sheet.is-in{transform:none}
.sheet-grab{width:38px;height:4px;border-radius:9px;background:var(--line-2);margin:6px auto 12px}
.sheet-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.sheet-t{font-size:17px;font-weight:760}
.sheet-in{max-width:var(--maxw);margin:0 auto}

/* dialog */
.dlg-back{position:fixed;inset:0;z-index:110;background:var(--overlay);display:grid;place-items:center;
  padding:24px;opacity:0;transition:opacity var(--med) var(--ease);backdrop-filter:blur(4px)}
.dlg-back.is-in{opacity:1}
.dlg{width:100%;max-width:380px;background:var(--surface);border:1px solid var(--line);
  border-radius:24px;padding:22px;transform:scale(.92) translateY(10px);
  transition:transform var(--med) var(--ease);box-shadow:0 24px 60px rgba(0,0,0,.45)}
.dlg-back.is-in .dlg{transform:none}
.dlg-i{width:52px;height:52px;border-radius:18px;display:grid;place-items:center;margin:0 auto 14px;
  background:var(--ac-soft);color:var(--ac)}
.dlg-t{font-size:17.5px;font-weight:760;text-align:center}
.dlg-m{font-size:13.5px;color:var(--muted);text-align:center;margin-top:8px;line-height:1.55}
.dlg-a{display:flex;gap:9px;margin-top:20px}
.dlg-a>*{flex:1}

/* toast */
.toast-root{position:fixed;left:0;right:0;bottom:calc(var(--tab-h) + var(--sab) + 16px);z-index:150;
  display:flex;flex-direction:column;align-items:center;gap:8px;pointer-events:none;padding:0 16px}
.toast{display:flex;align-items:center;gap:9px;max-width:var(--maxw);width:auto;
  background:var(--surface-3);color:var(--text);border:1px solid var(--line-2);
  padding:11px 15px;border-radius:15px;font-size:13px;font-weight:600;
  box-shadow:0 10px 30px rgba(0,0,0,.32);
  transform:translateY(14px) scale(.96);opacity:0;transition:all var(--med) var(--ease)}
.toast.is-in{transform:none;opacity:1}
.toast.ok{border-color:color-mix(in srgb,var(--ac) 45%,transparent)}
.toast.ok .t-i{color:var(--ac)}
.toast.err{border-color:color-mix(in srgb,var(--danger) 45%,transparent)}
.toast.err .t-i{color:var(--danger)}

/* update banner */
.ubanner{position:fixed;left:12px;right:12px;top:calc(var(--sat) + 6px);z-index:90;
  max-width:var(--maxw);margin:0 auto;display:flex;align-items:center;gap:11px;
  padding:11px 13px;border-radius:17px;background:var(--surface-3);
  border:1px solid color-mix(in srgb,var(--ac) 40%,transparent);
  box-shadow:0 12px 34px rgba(0,0,0,.35);
  transform:translateY(-140%);transition:transform var(--slow) var(--ease)}
.ubanner.is-in{transform:none}
.ubanner .u-b{flex:1;min-width:0}
.ubanner .u-t{font-size:13px;font-weight:720}
.ubanner .u-s{font-size:11px;color:var(--muted);margin-top:1px}

/* progress */
.prog{height:7px;border-radius:9px;background:var(--surface-3);overflow:hidden}
.prog i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--ac),var(--ac-2));
  width:0;transition:width 300ms var(--ease)}
.prog.indet i{width:38%;animation:load 1.15s var(--ease) infinite}
.filelist{max-height:190px;overflow-y:auto;margin-top:10px;scrollbar-width:none}
.filelist::-webkit-scrollbar{display:none}
.fitem{display:flex;align-items:center;gap:8px;padding:6px 0;font-size:11.5px;color:var(--muted);
  border-bottom:1px solid var(--line)}
.fitem:last-child{border-bottom:0}
.fitem .fn{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:ui-monospace,monospace}
.fitem.done{color:var(--ac)}
.fitem.active{color:var(--text)}

/* banner studio */
.tpl-strip{display:flex;gap:10px;overflow-x;padding:2px 0 6px;margin:0 calc(var(--sp)*-1);
  padding-left:var(--sp);padding-right:var(--sp);scrollbar-width:none}
.tpl-strip::-webkit-scrollbar{display:none}
.tpl{flex:0 0 auto;width:82px;border-radius:14px;overflow:hidden;border:2px solid transparent;
  transition:transform var(--fast) var(--ease),border-color var(--fast)}
.tpl.is-on{border-color:var(--ac)}
.tpl:active{transform:scale(.94)}
.tpl canvas{width:100%;height:auto;display:block}
.tpl-l{font-size:9.5px;text-align:center;color:var(--muted);padding:4px 2px;font-weight:650}
.preview{border-radius:20px;overflow:hidden;border:1px solid var(--line);background:var(--surface-2);
  box-shadow:var(--shadow)}
.preview canvas{width:100%;height:auto;display:block}

/* misc */
.quote{background:linear-gradient(140deg,var(--ac-soft),transparent 70%),var(--surface);
  border:1px solid var(--line);border-radius:var(--r-lg);padding:16px 16px 14px;margin-bottom:14px;position:relative}
.quote-q{font-size:14.5px;font-weight:640;line-height:1.6;color:var(--text)}
.quote-a{font-size:11px;color:var(--muted);margin-top:8px;display:flex;align-items:center;gap:6px}
.divider{height:1px;background:var(--line);margin:14px 0}
.kv{display:flex;justify-content:space-between;gap:12px;padding:7px 0;font-size:12.5px}
.kv .k{color:var(--muted)}
.kv .v{font-weight:650;text-align:right;word-break:break-all}
.mono{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px}
.badge{display:inline-flex;align-items:center;gap:4px;padding:3px 8px;border-radius:8px;font-size:10px;
  font-weight:750;letter-spacing:.3px;background:var(--ac-soft);color:var(--ac);text-transform:uppercase}
.badge.grey{background:var(--surface-3);color:var(--muted)}
.fade-in{animation:fadeUp 380ms var(--ease) both}
.stagger>*{animation:fadeUp 420ms var(--ease) both}
.stagger>*:nth-child(1){animation-delay:20ms}
.stagger>*:nth-child(2){animation-delay:60ms}
.stagger>*:nth-child(3){animation-delay:100ms}
.stagger>*:nth-child(4){animation-delay:140ms}
.stagger>*:nth-child(5){animation-delay:180ms}
.stagger>*:nth-child(6){animation-delay:220ms}
.stagger>*:nth-child(7){animation-delay:260ms}
.stagger>*:nth-child(8){animation-delay:300ms}
.ripple{position:absolute;border-radius:50%;background:currentColor;opacity:.16;
  transform:scale(0);animation:rip 520ms var(--ease) forwards;pointer-events:none}
@keyframes rip{to{transform:scale(2.6);opacity:0}}
.skel{background:linear-gradient(90deg,var(--surface-2),var(--surface-3),var(--surface-2));
  background-size:200% 100%;animation:sk 1.3s linear infinite;border-radius:10px}
@keyframes sk{to{background-position:-200% 0}}
@media (prefers-reduced-motion:reduce){*{animation-duration:.01ms!important;transition-duration:.01ms!important}}
@media (min-width:560px){:root{--sp:20px}}
